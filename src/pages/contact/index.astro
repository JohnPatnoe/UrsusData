---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact UrsusData | Data & Analytics Solutions"
  description="Contact UrsusData to discuss data engineering, analytics, business intelligence, data quality, and automation for your business."
  currentPage="contact"
>
  <main>
    <section class="hero">
      <div class="fade-up">
        <p class="eyebrow">Contact</p>
        <h1>Let’s turn your data into something more valuable</h1>
        <p class="lead">
          Whether you are launching a new data initiative, modernizing an existing workflow, or
          looking for stronger reporting and smarter automation, we can help you move from idea to
          execution with clarity and momentum.
        </p>
      </div>
    </section>
    <section class="section contact-grid">
      <div class="block fade-up">
        <h2>Start a conversation</h2>
        <p class="lead contact-intro">
          Reach out to <strong><a class="contact-email" href="mailto:contact@ursusdata.com">contact@ursusdata.com</a></strong> to
          request a service, schedule a discovery call, or discuss a new initiative. We typically
          work with founders, product teams, and growing organizations that want more reliable data,
          better reporting, or simpler automation.
        </p>
        <ul class="list">
          <li>Worldwide remote collaboration</li>
          <li>Typical response time: 1–2 business days</li>
          <li>Flexible engagements: data pipelines, analytics and reporting</li>
          <li>Scalable solutions tailored to your business needs</li>
          <li>Clear, practical, and data-driven approach</li>
          <li>End-to-end support from data to actionable insights</li>
          <li><strong>Project-based engagements with flexible scope</strong></li>
          <li><strong>Seamless integration with your existing tools and workflows</strong></li>
          <li><strong>Focus on data quality, reliability, and maintainability</strong></li>
          <li><strong>Direct communication and transparent project progress</strong></li>
        </ul>
      </div>
      <div class="block fade-up">
        <h2>Tell us about your project</h2>
        <p class="lead">
          Share the context, goals, timeline, and any current pain points. We’ll follow up with
          practical recommendations and clear next steps.
        </p>
        <form id="contactForm">
          <div class="form-group">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" maxlength="100" placeholder="Your name" required />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required />
          </div>
          <div class="form-group">
            <label for="service">What can we help you with?</label>
            <select id="service" name="service" required>
              <option value="" disabled selected>Select a service</option>
              <option value="Request a Quote">Request a Quote</option>
              <option value="Schedule a Meeting">Schedule a Meeting</option>
              <option value="General Inquiry">General Inquiry</option>
              <option value="Application Development">Application Development</option>
              <option value="Data Storage & Management">Data Storage &amp; Management</option>
              <option value="Hosting & Web Development">Hosting &amp; Web Development</option>
              <option value="Data Engineering & Integration">Data Engineering &amp; Integration</option>
              <option value="Business Intelligence & Analytics">Business Intelligence &amp; Analytics</option>
              <option value="Automation">Automation</option>
              <option value="Cloud Infrastructure">Cloud Infrastructure</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Project brief</label>
            <textarea id="message" name="message" maxlength="5000" placeholder="Tell us what you're building..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Submit form</button>
          <p id="formStatus" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contactForm");
  const status = document.querySelector<HTMLParagraphElement>("#formStatus");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form && status && submitButton) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const name = String(formData.get("name"));
      const email = String(formData.get("email"));
      const service = String(formData.get("service"));
      const message = String(formData.get("message"));

      submitButton.disabled = true;
      submitButton.textContent = "Submitting...";
      status.dataset.state = "pending";
      status.textContent = "Sending your message...";

      try {
        const response = await fetch("https://api.emailjs.com/api/v1.0/email/send", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            service_id: "Test1234",
            template_id: "Template1234",
            user_id: "SJugVNZyB3hnrCiRs",
            template_params: {
              name,
              email,
              service,
              message,
              from_name: name,
              from_email: email,
              reply_to: email,
              project_brief: message,
            },
          }),
        });

        if (!response.ok) {
          const details = await response.text();
          throw new Error(`EmailJS returned ${response.status}: ${details}`);
        }

        status.dataset.state = "success";
        status.textContent = "Thank you! Your message has been sent successfully.";
      } catch (error) {
        console.error("Failed to submit the contact form through EmailJS.", error);
        status.dataset.state = "error";
        status.textContent =
          "We couldn't send your message. Please try again or email contact@ursusdata.com.";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Submit form";
      }
    });
  }
</script>
